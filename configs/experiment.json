{
  "dataset": "BMAD Chest-RSNA",
  "image_size": 64,
  "normalization": "[0, 1] grayscale",
  "models": ["ae", "vae", "ganomaly"],
  "latent_dim": 64,
  "batch_size": 64,
  "epochs": 20,
  "learning_rate": 0.0002,
  "seeds": [13, 42, 73],
  "checkpoint_selection": "minimum normal-only validation loss",
  "threshold_selection": "maximum balanced accuracy on labeled validation",
  "primary_metric": "AUROC on held-out test",
  "secondary_metrics": [
    "AUPRC",
    "balanced_accuracy",
    "sensitivity",
    "specificity",
    "F1"
  ],
  "ganomaly_loss_weights": {
    "adversarial": 1.0,
    "contextual": 50.0,
    "latent": 1.0
  },
  "vae_beta": 0.0001
}
